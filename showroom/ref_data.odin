	{"Typography", "text-overflow", "text-overflow", "Utilities for controlling how the text of an element overflows.", "truncate\toverflow: hidden; text-overflow: ellipsis; white-space: nowrap;\ntext-ellipsis\ttext-overflow: ellipsis;\ntext-clip\ttext-overflow: clip;"},
