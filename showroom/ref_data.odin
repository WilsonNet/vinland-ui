	{"Filters", "filter-grayscale", "grayscale", "Utilities for applying grayscale filters to an element.", "grayscale\tfilter: grayscale(100%);\ngrayscale-<number>\tfilter: grayscale(<number>%);\ngrayscale-[<value>]\tfilter: grayscale(<value>);"},
