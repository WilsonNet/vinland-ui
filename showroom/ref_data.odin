	{"Typography", "letter-spacing", "letter-spacing", "Utilities for controlling the tracking, or letter spacing, of an element.", "tracking-tighter\tletter-spacing: -0.05em;\ntracking-tight\tletter-spacing: -0.025em;\ntracking-normal\tletter-spacing: 0em;\ntracking-wide\tletter-spacing: 0.025em;\ntracking-wider\tletter-spacing: 0.05em;\ntracking-widest\tletter-spacing: 0.1em;\ntracking-[<value>]\tletter-spacing: <value>;"},
	{"Typography", "line-clamp", "line-clamp", "Utilities for clamping text to a specific number of lines.", "line-clamp-<number>\toverflow: hidden; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: <number>;\nline-clamp-none\toverflow: visible; display: block; -webkit-box-orient: horizontal; -webkit-line-clamp: unset;\nline-clamp-[<value>]\toverflow: hidden; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: <value>;"},
	{"Typography", "line-height", "line-height", "Utilities for controlling the leading, or line height, of an element.", "text-<size>/<number>\tfont-size: <size>; line-height: calc(var(--spacing) * <number>);\ntext-<size>/[<value>]\tfont-size: <size>; line-height: <value>;\nleading-none\tline-height: 1;\nleading-<number>\tline-height: calc(var(--spacing) * <number>);\nleading-[<value>]\tline-height: <value>;"},
