// Hot reload support shared by the `vui-hot` runner and apps built as reloadable libraries.
//
// Hot reload is an optional development mode. A normal `odin build` of an app never touches
// this package at run time: `app.run` and `app.keep` turn into a plain loop and a no-op.
//
// How it works (see tools/vui-hot):
//
//   vui-hot (supervisor)   watches the app's packages, rebuilds it as a shared library
//                          (`-build-mode:dll`) on every real change, restarts the runner on a crash
//   vui-hot --child        the runner: loads the library, calls its `vui_hot_entry`, and swaps in
//                          the next build when told to, keeping the process, window and GPU device
//
// The app's window, GPU renderer, `ui.Context` (widget state, scroll positions, focus, caches)
// and every global registered with `app.keep` live in heap memory that survives the swap. Old
// libraries stay mapped until the runner exits, so string literals, procedure values and type
// info that live state still points at remain valid.
//
// This package must not depend on SDL or the rest of vui: the runner imports it too.
package vui_hot

import "base:runtime"
import "core:fmt"
import "core:hash"
import "core:mem"
import "core:slice"
import "core:strings"
import "core:sync"

// Bump when `Host` (or anything it embeds) changes layout. A library built against a different
// ABI refuses to run inside the runner and asks for a vui-hot restart.
HOST_ABI :: 4

// Name of the procedure every hot library exports (generated by vui-hot, see entry_source).
ENTRY_SYMBOL :: "vui_hot_entry"

Op :: enum i32 {
	Run, // start, or resume from `Host.persist`
	Shutdown, // tear down `Host.persist` with this library's code (its layout is the one that made it)
}

Result :: enum i32 {
	Quit, // the app exited (window closed, `running = false`)
	Reload, // a newer build is ready; state is parked in the host
	Incompatible, // the parked framework state has another layout: shut it down with the old library, then start cold
	Failed, // could not start (ABI mismatch, init failure)
}

Status :: enum u8 {
	Idle,
	Building,
	Error,
}

Entry_Proc :: #type proc "c" (host: ^Host, op: Op) -> Result

// Carried value of one `app.keep` global between two loads.
Snapshot :: struct {
	key:  string, // "<expression>|<type>", e.g. "&s|showroom.State"
	hash: u64, // fingerprint of `info`
	info: ^runtime.Type_Info, // the type as the old library knew it (that library stays mapped)
	data: []u8,
}

// Shared between the runner (owner) and the loaded library. All strings and slices stored here
// are allocated with `allocator`, whose procedure lives in the runner, so they stay valid
// whichever library frees them.
Host :: struct {
	abi:            u32,
	size:           u32, // size_of(Host) as the runner was built; a second layout check
	allocator:      runtime.Allocator,
	temp_allocator: runtime.Allocator, // the runner's main-thread arena, shared by every build
	args:           []string, // os.args for the app (a library has none of its own)
	app_name:       string, // default window app id / class (the package name)
	generation:     int, // build number of the library now running
	reloads:        int, // successful hot swaps in this process
	cold_starts:    int, // window (re)creations in this process
	persist:        rawptr, // framework state, owned by vui/app
	snapshots:      [dynamic]Snapshot,
	reload:         bool, // atomic: a newer build is ready, return Result.Reload at the next frame
	quit:           bool, // atomic: supervisor is gone or asked to stop
	wake:           proc "c" (data: rawptr), // atomic: interrupts the app's idle wait (set per load)
	wake_data:      rawptr,
	mutex:          sync.Mutex, // guards everything below
	status:         Status,
	error_text:     string, // compiler output of the last failed build
	error_gen:      int,
	build_ms:       f32, // compile time of the running generation
	swap_ms:        f32, // dlopen + resume of the last reload
	changed:        string, // files that triggered the running generation
	reloaded_ns:    i64, // monotonic time of the last swap (toast)
	notes:          [dynamic]string, // what happened to kept state at the last load
	status_version: u64, // bumped on every status change (lets the app redraw once)
}

host_init :: proc(h: ^Host, allocator := context.allocator) {
	h^ = {}
	h.abi = HOST_ABI
	h.size = size_of(Host)
	h.allocator = allocator
	h.snapshots.allocator = allocator
	h.notes.allocator = allocator
}

host_compatible :: proc "contextless" (h: ^Host) -> bool {
	return h != nil && h.abi == HOST_ABI && h.size == size_of(Host)
}

request_reload :: proc "contextless" (h: ^Host) {
	sync.atomic_store(&h.reload, true)
	host_wake(h)
}

request_quit :: proc "contextless" (h: ^Host) {
	sync.atomic_store(&h.quit, true)
	host_wake(h)
}

reload_requested :: proc "contextless" (h: ^Host) -> bool {
	return sync.atomic_load(&h.reload)
}

quit_requested :: proc "contextless" (h: ^Host) -> bool {
	return sync.atomic_load(&h.quit)
}

host_wake :: proc "contextless" (h: ^Host) {
	data := sync.atomic_load(&h.wake_data)
	if fn := sync.atomic_load(&h.wake); fn != nil {
		fn(data)
	}
}

set_wake :: proc "contextless" (h: ^Host, fn: proc "c" (data: rawptr), data: rawptr) {
	sync.atomic_store(&h.wake_data, data)
	sync.atomic_store(&h.wake, fn)
}

// Replaces a host-owned string under the caller's lock discipline.
host_set_string :: proc(h: ^Host, dst: ^string, s: string) {
	delete(dst^, h.allocator)
	dst^ = strings.clone(s, h.allocator)
}

host_set_notes :: proc(h: ^Host, notes: []string) {
	sync.mutex_lock(&h.mutex)
	defer sync.mutex_unlock(&h.mutex)
	for n in h.notes {
		delete(n, h.allocator)
	}
	clear(&h.notes)
	for n in notes {
		append(&h.notes, strings.clone(n, h.allocator))
	}
	h.status_version += 1
}

// ---------------------------------------------------------------------------
// Snapshots (kept globals)
// ---------------------------------------------------------------------------

snapshot_find :: proc(h: ^Host, key: string) -> ^Snapshot {
	for &s in h.snapshots {
		if s.key == key {
			return &s
		}
	}
	return nil
}

// Stores a copy of `size` bytes at `data` under `key`, replacing an older value.
snapshot_put :: proc(h: ^Host, key: string, info: ^runtime.Type_Info, data: rawptr) {
	bytes := mem.byte_slice(data, info.size)
	if s := snapshot_find(h, key); s != nil {
		delete(s.data, h.allocator)
		s.data = slice.clone(bytes, h.allocator)
		s.info = info
		s.hash = fingerprint(info)
		return
	}
	append(&h.snapshots, Snapshot{key = strings.clone(key, h.allocator), hash = fingerprint(info), info = info, data = slice.clone(bytes, h.allocator)})
}

snapshots_clear :: proc(h: ^Host) {
	for s in h.snapshots {
		delete(s.key, h.allocator)
		delete(s.data, h.allocator)
	}
	clear(&h.snapshots)
}

// Stable key for a kept value: the argument expression plus the full type name, so two globals
// of the same type (or two packages with an `&state`) never collide.
keep_key :: proc(expr: string, info: ^runtime.Type_Info, allocator := context.temp_allocator) -> string {
	sb := strings.builder_make(allocator)
	strings.write_string(&sb, expr)
	strings.write_byte(&sb, '|')
	type_name(&sb, info)
	return strings.to_string(sb)
}

@(private)
type_name :: proc(sb: ^strings.Builder, info: ^runtime.Type_Info) {
	if n, ok := info.variant.(runtime.Type_Info_Named); ok {
		if n.pkg != "" {
			strings.write_string(sb, n.pkg)
			strings.write_byte(sb, '.')
		}
		strings.write_string(sb, n.name)
		return
	}
	if p, ok := info.variant.(runtime.Type_Info_Pointer); ok {
		strings.write_byte(sb, '^')
		if p.elem == nil {
			strings.write_string(sb, "rawptr")
		} else {
			type_name(sb, p.elem)
		}
		return
	}
	fmt.sbprint(sb, info.id)
}

// ---------------------------------------------------------------------------
// Type fingerprints
// ---------------------------------------------------------------------------

// Structural hash of a type: kind, size, alignment, names, field offsets and the fingerprints
// of everything reachable from it. Equal fingerprints mean a value can be reused byte for byte
// by a library built from different source. It is independent of where the type info lives,
// so two builds of the same declarations agree.
fingerprint :: proc(info: ^runtime.Type_Info) -> u64 {
	stack: [dynamic]^runtime.Type_Info
	stack.allocator = context.temp_allocator
	return fp_type(info, &stack)
}

@(private)
fp_mix :: proc "contextless" (h: u64, v: u64) -> u64 {
	x := h ~ (v + 0x9e3779b97f4a7c15 + (h << 6) + (h >> 2))
	x ~= x >> 33
	x *= 0xff51afd7ed558ccd
	x ~= x >> 33
	return x
}

@(private)
fp_str :: proc "contextless" (h: u64, s: string) -> u64 {
	return fp_mix(h, hash.fnv64a(transmute([]u8)s))
}

@(private)
fp_type :: proc(info: ^runtime.Type_Info, stack: ^[dynamic]^runtime.Type_Info) -> u64 {
	if info == nil {
		return 0x6e696c // "nil"
	}
	// break cycles (a struct reachable from its own fields through a pointer)
	for s, depth in stack {
		if s == info {
			return fp_mix(0x5245_4300, u64(len(stack) - depth))
		}
	}
	append(stack, info)
	defer pop(stack)

	h := fp_mix(u64(info.size), u64(info.align))
	switch v in info.variant {
	case runtime.Type_Info_Named:
		h = fp_str(fp_str(fp_mix(h, 1), v.pkg), v.name)
		h = fp_mix(h, fp_type(v.base, stack))
	case runtime.Type_Info_Integer:
		h = fp_mix(fp_mix(fp_mix(h, 2), u64(v.signed)), u64(v.endianness))
	case runtime.Type_Info_Rune:
		h = fp_mix(h, 3)
	case runtime.Type_Info_Float:
		h = fp_mix(fp_mix(h, 4), u64(v.endianness))
	case runtime.Type_Info_Complex:
		h = fp_mix(h, 5)
	case runtime.Type_Info_Quaternion:
		h = fp_mix(h, 6)
	case runtime.Type_Info_String:
		h = fp_mix(fp_mix(fp_mix(h, 7), u64(v.is_cstring)), u64(v.encoding))
	case runtime.Type_Info_Boolean:
		h = fp_mix(h, 8)
	case runtime.Type_Info_Any:
		h = fp_mix(h, 9)
	case runtime.Type_Info_Type_Id:
		h = fp_mix(h, 10)
	case runtime.Type_Info_Pointer:
		h = fp_mix(fp_mix(h, 11), fp_type(v.elem, stack))
	case runtime.Type_Info_Multi_Pointer:
		h = fp_mix(fp_mix(h, 12), fp_type(v.elem, stack))
	case runtime.Type_Info_Procedure:
		h = fp_mix(fp_mix(fp_mix(h, 13), u64(v.convention)), u64(v.variadic))
		h = fp_mix(h, fp_type(v.params, stack))
		h = fp_mix(h, fp_type(v.results, stack))
	case runtime.Type_Info_Parameters:
		h = fp_mix(fp_mix(h, 14), u64(len(v.types)))
		for t in v.types {
			h = fp_mix(h, fp_type(t, stack))
		}
	case runtime.Type_Info_Array:
		h = fp_mix(fp_mix(fp_mix(h, 15), u64(v.count)), fp_type(v.elem, stack))
	case runtime.Type_Info_Enumerated_Array:
		h = fp_mix(fp_mix(fp_mix(h, 16), u64(v.count)), fp_type(v.elem, stack))
		h = fp_mix(fp_mix(h, fp_type(v.index, stack)), u64(v.is_sparse))
	case runtime.Type_Info_Dynamic_Array:
		h = fp_mix(fp_mix(h, 17), fp_type(v.elem, stack))
	case runtime.Type_Info_Slice:
		h = fp_mix(fp_mix(h, 18), fp_type(v.elem, stack))
	case runtime.Type_Info_Struct:
		h = fp_mix(fp_mix(fp_mix(h, 19), u64(v.field_count)), u64(transmute(u8)v.flags))
		h = fp_mix(h, u64(v.soa_kind))
		for i in 0 ..< int(v.field_count) {
			h = fp_str(h, v.names[i])
			h = fp_mix(h, u64(v.offsets[i]))
			h = fp_mix(h, u64(v.usings[i]))
			h = fp_mix(h, fp_type(v.types[i], stack))
		}
	case runtime.Type_Info_Union:
		h = fp_mix(fp_mix(fp_mix(h, 20), u64(len(v.variants))), u64(v.tag_offset))
		h = fp_mix(fp_mix(h, u64(v.no_nil)), u64(v.shared_nil))
		for t in v.variants {
			h = fp_mix(h, fp_type(t, stack))
		}
	case runtime.Type_Info_Enum:
		h = fp_mix(fp_mix(h, 21), fp_type(v.base, stack))
		for n, i in v.names {
			h = fp_mix(fp_str(h, n), u64(v.values[i]))
		}
	case runtime.Type_Info_Map:
		h = fp_mix(fp_mix(h, 22), fp_type(v.key, stack))
		h = fp_mix(h, fp_type(v.value, stack))
	case runtime.Type_Info_Bit_Set:
		h = fp_mix(fp_mix(h, 23), fp_type(v.elem, stack))
		h = fp_mix(fp_mix(fp_mix(h, fp_type(v.underlying, stack)), u64(v.lower)), u64(v.upper))
	case runtime.Type_Info_Simd_Vector:
		h = fp_mix(fp_mix(fp_mix(h, 24), u64(v.count)), fp_type(v.elem, stack))
	case runtime.Type_Info_Matrix:
		h = fp_mix(fp_mix(fp_mix(h, 25), u64(v.row_count)), u64(v.column_count))
		h = fp_mix(fp_mix(fp_mix(h, u64(v.elem_stride)), u64(v.layout)), fp_type(v.elem, stack))
	case runtime.Type_Info_Soa_Pointer:
		h = fp_mix(fp_mix(h, 26), fp_type(v.elem, stack))
	case runtime.Type_Info_Bit_Field:
		h = fp_mix(fp_mix(h, 27), fp_type(v.backing_type, stack))
		for i in 0 ..< v.field_count {
			h = fp_str(h, v.names[i])
			h = fp_mix(fp_mix(h, u64(v.bit_sizes[i])), u64(v.bit_offsets[i]))
			h = fp_mix(h, fp_type(v.types[i], stack))
		}
	case runtime.Type_Info_Fixed_Capacity_Dynamic_Array:
		h = fp_mix(fp_mix(fp_mix(h, 28), u64(v.capacity)), fp_type(v.elem, stack))
	case:
		h = fp_mix(h, 0xdead)
	}
	return h
}

// ---------------------------------------------------------------------------
// State migration
// ---------------------------------------------------------------------------

Migration :: struct {
	exact:   bool, // same fingerprint: copied byte for byte
	kept:    int, // leaf values carried over
	reset:   [dynamic]string, // paths left at the new default (type changed)
	added:   [dynamic]string, // fields that did not exist before (new default)
	removed: [dynamic]string, // fields that no longer exist (dropped)
}

migration_destroy :: proc(m: ^Migration) {
	delete(m.reset)
	delete(m.added)
	delete(m.removed)
}

// One-line human summary, e.g. "kept 12, added: theme, reset: count (type changed)".
migration_summary :: proc(m: ^Migration, allocator := context.temp_allocator) -> string {
	if m.exact {
		return "kept"
	}
	sb := strings.builder_make(allocator)
	fmt.sbprintf(&sb, "migrated: kept %d", m.kept)
	write_list :: proc(sb: ^strings.Builder, label: string, items: []string) {
		if len(items) == 0 {
			return
		}
		fmt.sbprintf(sb, ", %s: ", label)
		for it, i in items {
			if i > 0 {
				strings.write_string(sb, " ")
			}
			strings.write_string(sb, it)
			if i == 5 && len(items) > 6 {
				fmt.sbprintf(sb, " +%d", len(items) - 6)
				break
			}
		}
	}
	write_list(&sb, "added", m.added[:])
	write_list(&sb, "removed", m.removed[:])
	write_list(&sb, "reset", m.reset[:])
	return strings.to_string(sb)
}

// Copies what still fits from `src` (laid out as `src_info`, possibly from an older build) into
// `dst` (laid out as `dst_info`, already holding the new defaults). Identical types are copied
// whole; structs are matched field by field by name (recursively); fixed arrays element by
// element; integers and floats are converted when only their size changed. Everything else is
// left at its default and reported, never reinterpreted.
migrate :: proc(dst: rawptr, dst_info: ^runtime.Type_Info, src: rawptr, src_info: ^runtime.Type_Info, m: ^Migration, allocator := context.temp_allocator) {
	if fingerprint(dst_info) == fingerprint(src_info) {
		mem.copy(dst, src, dst_info.size)
		m.exact = true
		m.kept += 1
		return
	}
	if m.reset.allocator.procedure == nil {
		m.reset.allocator = allocator
		m.added.allocator = allocator
		m.removed.allocator = allocator
	}
	migrate_value(dst, dst_info, src, src_info, "", m, allocator)
}

@(private)
base_of :: proc(info: ^runtime.Type_Info) -> ^runtime.Type_Info {
	t := info
	for t != nil {
		n, ok := t.variant.(runtime.Type_Info_Named)
		if !ok {
			break
		}
		t = n.base
	}
	return t
}

@(private)
join_path :: proc(path, name: string, allocator: runtime.Allocator) -> string {
	if path == "" {
		return strings.clone(name, allocator)
	}
	return strings.concatenate({path, ".", name}, allocator)
}

@(private)
migrate_value :: proc(dst: rawptr, dst_info: ^runtime.Type_Info, src: rawptr, src_info: ^runtime.Type_Info, path: string, m: ^Migration, allocator: runtime.Allocator) {
	if fingerprint(dst_info) == fingerprint(src_info) {
		mem.copy(dst, src, dst_info.size)
		m.kept += 1
		return
	}
	db := base_of(dst_info)
	sb := base_of(src_info)
	label := path != "" ? path : "(value)"
	#partial switch d in db.variant {
	case runtime.Type_Info_Struct:
		s, ok := sb.variant.(runtime.Type_Info_Struct)
		if !ok || .raw_union in d.flags || .raw_union in s.flags || d.soa_kind != .None || s.soa_kind != .None {
			append(&m.reset, strings.clone(label, allocator))
			return
		}
		for i in 0 ..< int(d.field_count) {
			name := d.names[i]
			found := -1
			for j in 0 ..< int(s.field_count) {
				if s.names[j] == name {
					found = j
					break
				}
			}
			fp := join_path(path, name != "" ? name : "_", allocator)
			if found < 0 {
				append(&m.added, fp)
				continue
			}
			migrate_value(rawptr(uintptr(dst) + d.offsets[i]), d.types[i], rawptr(uintptr(src) + s.offsets[found]), s.types[found], fp, m, allocator)
		}
		for j in 0 ..< int(s.field_count) {
			name := s.names[j]
			gone := true
			for i in 0 ..< int(d.field_count) {
				if d.names[i] == name {
					gone = false
					break
				}
			}
			if gone {
				append(&m.removed, join_path(path, name, allocator))
			}
		}
		return
	case runtime.Type_Info_Array:
		s, ok := sb.variant.(runtime.Type_Info_Array)
		if !ok {
			break
		}
		n := min(d.count, s.count)
		for i in 0 ..< n {
			ep := fmt.aprintf("%s[%d]", label, i, allocator = allocator)
			migrate_value(rawptr(uintptr(dst) + uintptr(i * d.elem_size)), d.elem, rawptr(uintptr(src) + uintptr(i * s.elem_size)), s.elem, ep, m, allocator)
		}
		return
	case runtime.Type_Info_Integer:
		s, ok := sb.variant.(runtime.Type_Info_Integer)
		if !ok || d.endianness != s.endianness {
			break
		}
		v := read_int(src, sb.size, s.signed)
		if !int_fits(v, db.size, d.signed) {
			break // never wrap a value into a narrower type: keep the new default
		}
		write_int(dst, db.size, v)
		m.kept += 1
		return
	case runtime.Type_Info_Float:
		_, ok := sb.variant.(runtime.Type_Info_Float)
		if !ok || (db.size != 4 && db.size != 8) || (sb.size != 4 && sb.size != 8) {
			break
		}
		v := sb.size == 4 ? f64((^f32)(src)^) : (^f64)(src)^
		if db.size == 4 {
			(^f32)(dst)^ = f32(v)
		} else {
			(^f64)(dst)^ = v
		}
		m.kept += 1
		return
	}
	append(&m.reset, strings.clone(label, allocator))
}

@(private)
read_int :: proc(p: rawptr, size: int, signed: bool) -> i128 {
	switch size {
	case 1:
		return signed ? i128((^i8)(p)^) : i128((^u8)(p)^)
	case 2:
		return signed ? i128((^i16)(p)^) : i128((^u16)(p)^)
	case 4:
		return signed ? i128((^i32)(p)^) : i128((^u32)(p)^)
	case 8:
		return signed ? i128((^i64)(p)^) : i128((^u64)(p)^)
	case 16:
		return (^i128)(p)^
	}
	return 0
}

@(private)
int_fits :: proc(v: i128, size: int, signed: bool) -> bool {
	if size >= 16 {
		return signed || v >= 0
	}
	bits := uint(size * 8)
	if signed {
		lo := -(i128(1) << (bits - 1))
		hi := (i128(1) << (bits - 1)) - 1
		return v >= lo && v <= hi
	}
	return v >= 0 && v <= (i128(1) << bits) - 1
}

@(private)
write_int :: proc(p: rawptr, size: int, v: i128) {
	switch size {
	case 1:
		(^u8)(p)^ = u8(v)
	case 2:
		(^u16)(p)^ = u16(v)
	case 4:
		(^u32)(p)^ = u32(v)
	case 8:
		(^u64)(p)^ = u64(v)
	case 16:
		(^i128)(p)^ = v
	}
}
