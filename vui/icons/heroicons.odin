Icons :: struct {
	adjustments_horizontal: vui.Icon,
	arrow_left: vui.Icon,
	arrow_path: vui.Icon,
	arrow_right: vui.Icon,
	arrow_up_right: vui.Icon,
	bars_3: vui.Icon,
	beaker: vui.Icon,
	bell: vui.Icon,
	bolt: vui.Icon,
	book_open: vui.Icon,
	calendar: vui.Icon,
	chat_bubble_left: vui.Icon,
	check_circle: vui.Icon,
	check: vui.Icon,
	chevron_down: vui.Icon,
	chevron_left: vui.Icon,
	chevron_right: vui.Icon,
	chevron_up: vui.Icon,
	clipboard: vui.Icon,
	clock: vui.Icon,
	code_bracket: vui.Icon,
	cog_6_tooth: vui.Icon,
	command_line: vui.Icon,
	computer_desktop: vui.Icon,
	cube: vui.Icon,
	cursor_arrow_rays: vui.Icon,
	document_duplicate: vui.Icon,
	envelope: vui.Icon,
	exclamation_triangle: vui.Icon,
	eye: vui.Icon,
	fire: vui.Icon,
	globe_alt: vui.Icon,
	heart: vui.Icon,
	home: vui.Icon,
	information_circle: vui.Icon,
	light_bulb: vui.Icon,
	lock_closed: vui.Icon,
	magnifying_glass: vui.Icon,
	map_pin: vui.Icon,
	minus: vui.Icon,
	moon: vui.Icon,
	musical_note: vui.Icon,
	paint_brush: vui.Icon,
	pause: vui.Icon,
	photo: vui.Icon,
	play: vui.Icon,
	plus: vui.Icon,
	rectangle_stack: vui.Icon,
	rocket_launch: vui.Icon,
	sparkles: vui.Icon,
	squares_2x2: vui.Icon,
	star: vui.Icon,
	sun: vui.Icon,
	swatch: vui.Icon,
	trash: vui.Icon,
	user: vui.Icon,
	x_circle: vui.Icon,
	x_mark: vui.Icon,
}

// Registers every icon with the context and returns the handles.
register :: proc(ctx: ^vui.Context) -> (ic: Icons) {
