---
// A rendered vinland-ui example: native screenshots for light and dark mode, upgraded to a
// live WebAssembly/WebGL2 canvas when `live` names a demo compiled into demos.wasm.
interface Props {
	src: string;
	width: number;
	height: number;
	alt: string;
	live?: string;
}
const { src, width, height, alt, live } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<figure class="vui-preview not-content">
	{live && <canvas id={live} tabindex="0" style={`height:${height}px`} aria-label={`Live demo: ${alt}`} />}
	<img class="vui-light" src={`${base}/img/${src}-light.webp`} width={width} height={height} alt={alt} loading="lazy" decoding="async" />
	<img class="vui-dark" src={`${base}/img/${src}-dark.webp`} width={width} height={height} alt={alt} loading="lazy" decoding="async" />
</figure>
{
	live && (
		<script is:inline define:vars={{ base }}>
			if (!window.__vuiLive) {
				window.__vuiLive = true;
				const root = document.documentElement;
				const sync = () => { root.id = 'vui-root'; root.classList.toggle('dark', root.dataset.theme !== 'light'); };
				sync();
				new MutationObserver(sync).observe(root, { attributes: true, attributeFilter: ['data-theme'] });
				const ok = (() => { try { return !!document.createElement('canvas').getContext('webgl2') && !!window.WebAssembly; } catch { return false; } })();
				if (ok) {
					const s = document.createElement('script');
					s.src = base + '/odin.js';
					s.onload = () => window.odin.runWasm(base + '/demos.wasm').catch((e) => console.warn('vinland-ui live demos unavailable', e));
					document.head.appendChild(s);
				}
			}
		</script>
	)
}

<style>
	.vui-preview {
		margin-top: 1.5rem;
		padding: 4px;
		border-radius: 12px;
		background: color-mix(in srgb, var(--sl-color-gray-1) 6%, transparent);
		box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--sl-color-gray-1) 8%, transparent);
	}
	.vui-preview img,
	.vui-preview canvas {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 8px;
		background: var(--vui-preview-bg);
	}
	.vui-preview canvas {
		display: none;
		outline: none;
	}
	.vui-preview canvas[style*='block'] ~ img {
		display: none !important;
	}
	.vui-dark {
		display: none !important;
	}
	:global([data-theme='dark']) .vui-dark {
		display: block !important;
	}
	:global([data-theme='dark']) .vui-light {
		display: none !important;
	}
	.vui-preview + :global(.expressive-code) {
		margin-top: 4px !important;
	}
</style>
